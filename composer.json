{
    "name": "goodport/laravel-js-error-logger",
    "description": "Capture browser JavaScript errors and write them to a Laravel log channel.",
    "type": "library",
    "homepage": "https://github.com/goodport/laravel-js-error-logger",
    "license": "MIT",
    "authors": [
        {
            "name": "goodport"
        }
    ],
    "keywords": [
        "error-handling",
        "javascript",
        "laravel",
        "logging",
        "monitoring"
    ],
    "require": {
        "ext-mbstring": "*",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "php": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Goodport\\JsErrorLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goodport\\JsErrorLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Goodport\\JsErrorLogger\\JsErrorLoggerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
